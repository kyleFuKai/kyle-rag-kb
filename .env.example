# ============================================================
# 环境变量模板：克隆项目后，复制本文件为 .env 并填好值即可运行
#   (Windows)  copy .env.example .env
#   (Linux/Mac) cp .env.example .env
#
# .env 已被 .gitignore 忽略，填了真实密钥也不会提交到 Git。
# Spring Boot 启动时通过 spring-dotenv 自动读取 .env，
# 真实环境变量优先级更高（CI/生产直接设环境变量即可覆盖）。
# ============================================================

# ===== PostgreSQL（云服务器，走 SSH 隧道时填 127.0.0.1） =====
# 推荐做法：安全组只开 22，数据库端口不对公网暴露；
DB_HOST=127.0.0.1
DB_USERNAME=
DB_PASSWORD=

# ===== Redis（云服务器，同上走隧道） =====
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=

# ===== MiniMax（大模型对话） =====
MINIMAX_API_KEY=

# ===== 阿里百炼（向量化 + 重排，一个 key 两处用） =====
DASHSCOPE_API_KEY=

# ===== Reranker（阿里百炼 qwen3-rerank，key 填上面同一个） =====
RERANKER_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANKER_API_KEY=
RERANKER_MODEL=qwen3-rerank

# ===== MinIO（对象存储） =====
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=http://127.0.0.1:9100
